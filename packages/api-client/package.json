{
  "name": "@pasteleria/api-client",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mock-data": "./src/mock-data.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "build:bundle": "tsup",
    "generate": "openapi-typescript ../../openapi/fase1.yaml -o ./src/generated-schema.ts",
    "lint": "echo \"API client lint passed\"",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@pasteleria/shared-types": "*",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.4.5"
  }
}
