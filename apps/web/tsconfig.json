{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@pasteleria/api-client": ["../../packages/api-client/src"],
      "@pasteleria/api-client/*": ["../../packages/api-client/src/*"],
      "@pasteleria/shared-types": ["../../packages/shared-types/src"],
      "@pasteleria/shared-types/*": ["../../packages/shared-types/src/*"],
      "@pasteleria/ui": ["../../packages/ui/src"],
      "@pasteleria/ui/*": ["../../packages/ui/src/*"],
      "@repo/api-client": ["../../packages/api-client/src"],
      "@repo/api-client/*": ["../../packages/api-client/src/*"],
      "@repo/shared-types": ["../../packages/shared-types/src"],
      "@repo/shared-types/*": ["../../packages/shared-types/src/*"],
      "@repo/ui": ["../../packages/ui/src"],
      "@repo/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
