# ==========================================
# Configuración del Entorno - Monorepo Pastelería
# ==========================================

# Puerto y Host del Backend FastAPI
API_HOST=0.0.0.0
API_PORT=4000
API_SECRET_KEY=super-secret-key-change-in-production-pasteleria-2026
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de Datos (PostgreSQL / SQLite para dev)
DATABASE_URL=sqlite:///./pasteleria.db

# Orígenes Permitidos (CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006,exp://127.0.0.1:8081

# Next.js 14 (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_TENANT_ID=default-atelier
NEXT_PUBLIC_ENABLE_MOCK=false

# Expo React Native (apps/mobile)
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_TENANT_ID=default-atelier
